@echo off
:: تغيير الترميز لدعم اللغة العربية في نافذة الأوامر
chcp 65001 > nul

title 📡 محاكي أجهزة المنزل الذكي - ضخ البيانات لكافكا

echo ==========================================================
echo       📡 جاري تشغيل محاكي الأجهزة (appliance_simulator.py)...
echo ==========================================================
echo.

:: الانتقال التلقائي لمجلد الملف الرئيسي وتفعيل البيئة
cd /d "%~dp0"
echo 🔌 جاري تفعيل البيئة الافتراضية (venv)...
call "%~dp0venv\Scripts\activate.bat"

echo.
:: الدخول إلى مجلد المحاكي وتشغيله
cd /d "%~dp0ingestion"
echo 📁 المسار الحالي: %cd%
echo 🚀 بدء توليد البيانات وبثها...
echo ==========================================================
echo.

python appliance_simulator.py

pause