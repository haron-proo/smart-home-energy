@echo off
:: تغيير الترميز لدعم اللغة العربية في نافذة الأوامر
chcp 65001 > nul

title 🐳 تشغيل منظومة دوكر - Docker Compose Engine

echo ==========================================================
echo       🐳 جاري إطلاق حاويات الدوكر (Airflow, Kafka, Postgres, Metabase, Spark)...
echo ==========================================================
echo.

:: الانتقال التلقائي لمجلد الملف الرئيسي أينما كان
cd /d "%~dp0"

echo 📁 المسار الحالي: %cd%
echo 🚀 جاري تشغيل الحاويات في الخلفية (Detached Mode)...
echo ----------------------------------------------------------

:: أمر تشغيل ملف الكومبوز الخاص بك بدقة
docker-compose -f docker-compose-clean.yaml up -d

echo ----------------------------------------------------------
echo ✅ تم إرسال أمر التشغيل لدوكر بنجاح!
echo 🔍 جاري فحص حالة الحاويات الآن...
echo ----------------------------------------------------------
echo.

:: عرض الحاويات الشغالة حالياً للتأكد من إقلاعها
docker ps

echo.
echo ==========================================================
echo 💡 الحاويات تعمل الآن في الخلفية بأمان.
