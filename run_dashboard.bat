@echo off
:: تغيير الترميز لدعم اللغة العربية في نافذة الأوامر
chcp 65001 > nul

title 🌐 خادم ويب FastAPI - لوحة التحكم والـ Logs

echo ==========================================================
echo       🌐 جاري تشغيل خادم ويب FastAPI على البورت 8066...
echo ==========================================================
echo.

:: الانتقال التلقائي لمجلد الملف الرئيسي وتفعيل البيئة
cd /d "%~dp0"
echo 🔌 جاري تفعيل البيئة الافتراضية (venv)...
call "%~dp0venv\Scripts\activate.bat"

echo.
:: الدخول إلى مجلد الداشبورد
cd /d "%~dp0dashboard"
echo 📁 المسار الحالي: %cd%

:: فتح المتصفح تلقائياً على صفحة الداشبورد
start "" "http://127.0.0.1:9066/dashboard"

echo 🚀 بدء تشغيل السيرفر ومراقبة التغييرات الحية...
echo 🛑 لإغلاق الخادم، اضغط على Ctrl + C في هذه النافذة.
echo ==========================================================
echo.

python app.py

pause